  },
  "bosses": {
    "type": "checkbox",
    "value": true,
    "text": "Boss fights",
    "help": "Destroying enemies on a world fills its boss meter. When it is full, that world's boss turns up."
  },
  "eggs": {
    "type": "checkbox",
    "value": true,
    "text": "Easter eggs"
  },
  "cheats": {
    "type": "checkbox",
    "value": true,
    "text": "Allow the secret cheats menu",
    "help": "When off, the secret key combination that reveals the Cheats tab in the hangar does nothing."
  },
  "resetProgress": {
    "text": "Reset all progress (credits, upgrades, weapons, ships, worlds, score)",
    "type": "button",
    "value": "Reset"
  },
  "labelPerf": {
    "type": "label",
    "value": "Performance"
  },
  "fpsLimit": {
    "type": "dropdown",
    "value": 1,
    "text": "Frame rate limit",
    "items": [
      "30 fps",
      "60 fps",
      "Uncapped"
    ]
  }
