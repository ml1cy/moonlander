    "value": 20
  },
  "steering": {
    "max": 200,
    "min": 25,
    "step": 5,
    "text": "Steering sensitivity (%)",
    "type": "slider",
    "value": 100
  },
  "showHud": {
    "type": "checkbox",
    "value": true,
    "text": "Show score while playing"
  },
  "clickToFly": {
    "type": "checkbox",
    "value": true,
    "text": "Click ground to pick landing site",
    "help": "Random hops mode only"
  },
  "mouseParallax": {
    "type": "checkbox",
    "value": true,
    "text": "Mouse parallax on stars"
  },
  "labelFun": {
    "type": "label",
    "value": "Fun"
  },
  "aliens": {
    "type": "checkbox",
    "value": true,
    "text": "Alien visits",
    "help": "UFOs show up now and then while you're playing. Shoot or click them three times."
  },
  "sputniks": {
    "type": "checkbox",
    "value": true,
    "text": "Sputnik attacks",
    "help": "Enemy Sputnik squadrons attack over the Moon and Earth while you're flying the ship yourself. They retreat when autopilot takes over."
  },
  "natives": {
    "type": "checkbox",
    "value": true,
    "text": "Planet natives and mines",
