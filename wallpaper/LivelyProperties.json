    "type": "label",
    "value": "Interaction"
  },
  "keyboardControl": {
    "type": "checkbox",
    "value": true,
    "text": "Fly with arrow keys / WASD (Space fires, H autopilot, Tab upgrades)",
    "help": "Also enable keyboard input in Lively: Settings > Wallpaper > Interaction > Wallpaper Input > Keyboard"
  },
  "dragRocket": {
    "type": "checkbox",
    "value": true,
